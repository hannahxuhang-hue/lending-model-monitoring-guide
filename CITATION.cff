    given-names: "Hang"
    alias: "Hannah Xu"
version: "1.0.0"
date-released: "2026-10-01"
license: ["CC-BY-4.0", "MIT"]
repository-code: "https://github.com/hannahxuhang-hue/lending-model-monitoring-guide"
keywords:
  - model risk management
  - model monitoring
  - CDFI
  - community banks
  - credit unions
  - fair lending
  - population stability index
